{
  "name": "riskline",
  "private": true,
  "version": "0.1.0",
  "description": "Your stop, target and P&L at a glance on Even G2 glasses, with one-tap risk-reducing actions",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --test \"test/*.test.ts\"",
    "simulate": "evenhub-simulator http://localhost:5173",
    "pack": "npm run build && evenhub pack app.json dist --sdk-ver 0.0.16 -o riskline.ehpk"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16",
    "@evenrealities/pretext": "^0.1.4"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.2.0",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
